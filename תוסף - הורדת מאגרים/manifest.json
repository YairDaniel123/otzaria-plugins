{
  "schemaVersion": 1,
  "id": "otzaria-github-downloader",
  "name": "הורדת מאגר גיטאב",
  "version": "2.0.2",
  "description": "הורדה ועדכון מאגרי ספרים מ-GitHub",
  "author": "Yair Daniel",
  "stability": "beta",
  "entrypoint": "index.html",
  "minAppVersion": "0.9.92",
  "sdkVersion": "1.x",
  "permissions": [
    "network.access",
    "ui.feedback"
  ],
  "network": {
    "enabled": true,
    "allowlist": [
      "api.github.com",
      "raw.githubusercontent.com",
      "objects.githubusercontent.com",
      "github.com"
    ]
  },
  "contributes": {
    "toolTab": {
      "title": "הורדת מאגר גיטאב",
      "order": 100,
      "defaultPinned": true,
      "iconCodepoint": 60094,
      "iconVariant": "regular"
    }
  }
}
